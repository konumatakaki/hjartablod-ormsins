 var sessions = {};
 
 
+// hjartablod-ormsins: 投稿サイトと同じルビの記法「|漢字《よみ》」（半角の |）を使えるようにする。
+// inklecate に渡す前に、波括弧 { } の外にある「|漢字《よみ》」だけを全角の「｜漢字《よみ》」に置き換える。
+// 行の数は変えないので、エラーの行番号はそのまま正しい。元のファイルは書き換えない。
+// 中身は hjartablod-ormsins の tools/ink-preprocess.mjs と同じ。
+const RUBY = /(?<!\\)\|([^|《》{}\n]+)《([^》\n]+)》/g;
+function rubyPreprocessLine(line) {
+    const c = line.indexOf("//");
+    const body = c >= 0 ? line.slice(0, c) : line;
+    const rest = c >= 0 ? line.slice(c) : "";
+    let out = "", depth = 0, chunk = "";
+    const flush = () => { out += depth === 0 ? chunk.replace(RUBY, "｜$1《$2》") : chunk; chunk = ""; };
+    for (const ch of body) {
+        if (ch === "{") { flush(); depth++; out += ch; continue; }
+        if (ch === "}") { flush(); depth = Math.max(0, depth - 1); out += ch; continue; }
+        chunk += ch;
+    }
+    flush();
+    return out + rest;
+}
+function rubyPreprocess(source) {
+    return source.split("\n").map(rubyPreprocessLine).join("\n");
+}
